{
  "app": "nodegoat",
  "commit": "c5cb68a7084e4ae7dcc60e6a98768720a81841e8",
  "note": "Written by hand from server.js and app/routes/index.js and tutorial.js at the pinned commit, not produced by the map. Routes are in registration order. middleware is the chain in front of the handler without application-wide app.use middleware (that is appMiddleware, registered in server.js before routes(app, db) runs). Labels are the source form of each argument: an identifier is its name, a call is its callee name followed by (). Three things the map must not invent: app.use('/tutorial', tutorialRouter) is a mount, not a route; app.use(ErrorHandler) is registered after every route, so it is in no route's chain; app.get('/learn', ...) has an inline handler, so its handlerFile is index.js. The twelve /tutorial/<page> routes come from a for...of loop over a literal array in tutorial.js.",
  "appMiddleware": [
    "favicon()",
    "bodyParser.json()",
    "bodyParser.urlencoded()",
    "session()",
    "express.static()"
  ],
