# Placeholder keys only. A real .env is never committed.
# Names below are the ones the code reads (apps/api/src/config.ts, apps/worker/src/config.ts).
# Copy to .env locally and fill in values from the shared secrets store.
AFFIDAVIT_APP_DATABASE_URL=
AFFIDAVIT_WORKER_DATABASE_URL=
AFFIDAVIT_GITHUB_WEBHOOK_SECRET=
AFFIDAVIT_SESSION_SECRET=
ANTHROPIC_API_KEY=
# Required by the worker: image ID printed by `pnpm --filter @affidavit/judge runner-image`.
AFFIDAVIT_WITNESS_RUNNER_IMAGE=
