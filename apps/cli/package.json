{
  "name": "@affidavit/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "affidavit": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@affidavit/contracts": "workspace:*",
    "@affidavit/db": "workspace:*",
    "@affidavit/evidence": "workspace:*",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@affidavit/worker": "workspace:*"
  }
}
