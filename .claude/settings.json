      "Bash(pnpm --filter @affidavit/web dev:*)",
      "Bash(pnpm --filter @affidavit/contracts export:schema)",
      "Bash(pnpm --filter @affidavit/testing generate:fixtures)"
    ],
    "deny": [
      "Bash(docker * --privileged*)",
      "Bash(docker * /var/run/docker.sock*)",
      "Bash(docker * docker.sock*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm * exec*)",
      "Bash(pnpm * dlx*)",
      "Bash(docker * --cap-add*)",
      "Bash(docker * --net=host*)",
      "Bash(docker * --network=host*)",
      "Bash(docker * --network host*)",
      "Bash(docker * --pid=host*)",
      "Bash(docker * --device*)",
      "Bash(docker * seccomp=unconfined*)",
      "Bash(docker * apparmor=unconfined*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/stop-check.mjs"
          }
        ]
      }
    ]
  }
}
