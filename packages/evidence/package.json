{
  "name": "@affidavit/evidence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:sandbox-host": "AFFIDAVIT_SANDBOX_HOST=1 vitest run src/replay.integration.test.ts",
    "test:s3": "vitest run src/store.s3.integration.test.ts",
    "verify": "node --import tsx src/verify-main.ts"
  },
  "dependencies": {
    "@affidavit/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1161.0",
    "tar-stream": "3.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@affidavit/judge": "workspace:*",
    "@affidavit/sandbox": "workspace:*",
    "@types/tar-stream": "3.1.5"
  }
}
