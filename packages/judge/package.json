{
  "name": "@affidavit/judge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:sandbox-host": "AFFIDAVIT_SANDBOX_HOST=1 vitest run --no-file-parallelism src/jail",
    "containment": "tsx src/jail/cli.ts",
    "runner-image": "docker build --quiet --provenance=false --sbom=false --build-arg SOURCE_DATE_EPOCH=0 --tag affidavit/witness-runner:local ../../docker/sandbox/witness-runner"
  },
  "dependencies": {
    "@affidavit/contracts": "workspace:*",
    "@affidavit/sandbox": "workspace:*",
    "@opentelemetry/api": "1.10.0"
  }
}
