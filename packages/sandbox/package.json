{
  "name": "@affidavit/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:sandbox-host": "AFFIDAVIT_SANDBOX_HOST=1 vitest run --no-file-parallelism src/gvisor src/boot",
    "containment": "tsx src/containment/cli.ts"
  },
  "dependencies": {
    "@affidavit/contracts": "workspace:*",
    "dockerode": "5.0.1",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@affidavit/testing": "workspace:*",
    "@types/dockerode": "4.0.2"
  }
}
